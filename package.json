{
  "name": "resound-fe",
  "version": "1.0.0",
  "description": "resound front end",
  "main": "main.js",
  "lint-staged": {
    "**/*.{js,json}": "prettier --write"
  },
  "scripts": {
    "test": "jest --watch",
    "test:ci": "jest",
    "start": "npx vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "lint": "eslint . --ext .js --ignore-pattern dist",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calebjedhugo/resound-fe.git"
  },
